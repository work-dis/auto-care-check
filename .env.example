# ─── AutoPulse — Environment Variables ───────────────────────────
# Copy to .env and fill in. For Vercel, set these in Dashboard.
#
# Локальные значения ниже работают с docker-compose.yml.
# Для Vercel задайте production-значения в настройках проекта.
# ──────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# LOCAL (Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autopulse?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autopulse?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autopulse_test?schema=public"

# PRODUCTION (Neon on Vercel):
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Application ───────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET="autopulse-dev-secret-change-in-production"
DATA_ENCRYPTION_KEY="replace-with-a-separate-random-secret"

# ── Vercel Cron ───────────────────────────────────────────────────
CRON_SECRET="replace-with-a-random-16-char-secret"

# ── Telegram (optional — login widget) ────────────────────────────
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# ── Web Push (VAPID) ──────────────────────────────────────────────
# Generate keys: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-generated-public-key"
VAPID_PRIVATE_KEY="replace-with-generated-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# ── Email (SMTP, optional — email notifications) ──────────────────
# SMTP_HOST="smtp.yandex.ru"
# SMTP_PORT=465
# SMTP_USER="your@email.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@autopulse.app"
# SMTP_FROM_NAME="AutoPulse"

# Public app URL (for email links)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Cloudinary (optional — image upload) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Receipt OCR (optional) ────────────────────────────────────────
OCR_SPACE_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Vercel Dashboard — set these as Environment Variables there:
#   DATABASE_URL, DIRECT_URL, JWT_SECRET, DATA_ENCRYPTION_KEY, CRON_SECRET
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#   NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
#
# Vercel auto-sets: VERCEL=1, NEXT_PUBLIC_VERCEL_URL
